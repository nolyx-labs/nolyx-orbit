{
  "name": "nolyx-orbit-web",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && touch dist/.gitkeep",
    "typecheck": "tsc -b",
    "emails": "node emails/build.mjs",
    "test": "node --test 'src/**/*.test.ts'",
    "format": "prettier --write \"{src,emails}/**/*.{ts,tsx,css,mjs}\"",
    "format:check": "prettier --check \"{src,emails}/**/*.{ts,tsx,css,mjs}\""
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "lucide-react": "1.66.0",
    "qrcode-generator": "2.0.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router": "8.5.1",
    "uplot": "1.6.32"
  },
  "devDependencies": {
    "@react-email/components": "1.0.12",
    "@resvg/resvg-js": "2.6.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "prettier": "3.9.10",
    "typescript": "7.0.2",
    "vite": "8.3.5"
  }
}
