# HTTPS for Orbit (docker compose --profile https). Certificates come from Let's Encrypt.
{
	# Status pages on their own domains get certificates on first visit, but only for domains Orbit
	# says belong to a status page, so strangers can't make Caddy request certificates for anything.
	on_demand_tls {
		ask http://orbit:8080/internal/tls-ask
	}
}

{$ORBIT_DOMAIN} {
	reverse_proxy orbit:8080
}

https:// {
	tls {
		on_demand
	}
	reverse_proxy orbit:8080
}
