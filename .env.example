# ── Required ────────────────────────────────────────────────────────────────
# 32-byte key that encrypts secrets at rest and derives the agent command-signing key.
# Generate once with: openssl rand -hex 32
# Keep it safe: losing or changing it makes stored secrets unreadable and agents must re-enroll.
ENCRYPTION_KEY=

# The URL people and agents use to reach this control plane. Used for install commands,
# invite links, webhooks and secure cookies (cookies are Secure when this starts with https://).
#   HTTPS: APP_URL=https://orbit.example.com
#   HTTP:  APP_URL=http://203.0.113.10:8080
APP_URL=http://localhost:8080

# ── HTTPS (optional, with `docker compose --profile https up -d`) ───────────
# Domain Caddy requests a Let's Encrypt certificate for. Must match APP_URL's host.
ORBIT_DOMAIN=
# Set to 127.0.0.1 behind the proxy so port 8080 isn't reachable from the internet.
ORBIT_BIND=0.0.0.0
ORBIT_PORT=8080

# ── Database ────────────────────────────────────────────────────────────────
POSTGRES_PASSWORD=orbit

# ── Access ──────────────────────────────────────────────────────────────────
# The first user and invited people can always sign up. true opens sign-up to anyone.
ALLOW_SIGNUP=false
# Allow alert webhooks to private/internal addresses (e.g. an on-prem chat server).
ALLOW_PRIVATE_WEBHOOKS=false

# ── Email (optional): alert emails and member invitations ───────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
